# NameScout configuration. Copy to .env.local and fill in what you have.
# Everything is optional — Porkbun + Cloudflare work with zero credentials,
# and without Supabase the app reads/writes a local data/prices.json snapshot.

# --- Price store (optional) ---
# Set both to use Supabase instead of the local JSON snapshot.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Extra price feeds (optional) ---
# Free Dynadot reseller account API key — unlocks the Dynadot price column.
DYNADOT_API_KEY=
# Cloudflare API token — when set, production should use the live Registrar API
# (currently falls back to the at-cost baseline; see lib/registrars/cloudflare.ts).
CF_API_TOKEN=

# --- Affiliate IDs (optional, public) ---
# Drop these in once each program approves your live site; until then the
# "Buy" links go direct (unmonetized) and are labelled as such.
NEXT_PUBLIC_DYNADOT_AFFILIATE_ID=
NEXT_PUBLIC_NAMECHEAP_AFFILIATE_ID=
NEXT_PUBLIC_GODADDY_CJ_ID=
